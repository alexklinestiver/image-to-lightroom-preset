      <crs:Name>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Ivory Garden</rdf:li>
        </rdf:Alt>
      </crs:Name>
      <crs:Group>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Freddy Universe - Reference Looks</rdf:li>
        </rdf:Alt>
      </crs:Group>
      <crs:Description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Ivory Garden: bright, airy outdoor wedding look with creamy soft highlights, golden-warm mids and shadows, muted olive greens and clean deep blacks. Exposure, white balance and camera profile preserved. Inferred grade; not rendered or import-tested in Lightroom.</rdf:li>
        </rdf:Alt>
      </crs:Description>
